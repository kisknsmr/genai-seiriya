{
  "manifest_version": 3,
  "name": "生成AI整理屋さん",
  "version": "1.1.0",
  "description": "Gemini・ChatGPT・Claude の会話をまとめて Markdown / HTML で保存。選んだ会話の一括削除もできます。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/core/net.js",
        "src/core/zip.js",
        "src/core/markdown.js",
        "src/core/exporters.js",
        "src/platforms/gemini.js",
        "src/platforms/chatgpt.js",
        "src/platforms/claude.js",
        "src/content/ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
